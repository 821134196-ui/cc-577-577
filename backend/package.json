{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch\" \"node --watch dist/main.js\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "npm run build && node dist/seed.js",
    "demo": "npm run build && node dist/demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.1",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2"
  }
}
